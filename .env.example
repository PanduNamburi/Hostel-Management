# ============================================================
# StayInn | Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# Security (generate a new one: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
SECRET_KEY=your-secret-key-here

# Set to False in production
DEBUG=False

# Email (Gmail App Password — NOT your main Gmail password)
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
